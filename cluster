#!/usr/bin/env bash
#
# cluster - Unified HPC Developer Suite
# Bridges remote clusters with your local workstation:
# Jupyter tunneling, interactive compute shells, drive mounting, code syncing, and job monitoring.
# Includes automatic lifecycle management: automatically unmounts drives and releases
# compute nodes when the terminal session closes.
#

set -euo pipefail

VERSION="1.1.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cluster"
CONFIG_FILE="$CONFIG_DIR/config"
LEGACY_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/cluster-jupyter/config"
FIRST_RUN_MARKER="$CONFIG_DIR/.first_run_done"

# Load configuration if available
if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
elif [[ -f "$LEGACY_CONFIG" ]]; then
    # shellcheck source=/dev/null
    source "$LEGACY_CONFIG"
fi

# Fallback defaults
HOST="${CLUSTER_HOST:-${HOST:-}}"
PORT="${CLUSTER_PORT:-${PORT:-8888}}"
SLURM_PARTITION="${SLURM_PARTITION:-medium}"
SLURM_ACCOUNT="${SLURM_ACCOUNT:-}"
SLURM_QOS="${SLURM_QOS:-}"
SLURM_CPUS="${SLURM_CPUS:-4}"
SLURM_MEM="${SLURM_MEM:-8G}"
SLURM_TIME="${SLURM_TIME:-04:00:00}"
GPU_PARTITION="${GPU_PARTITION:-gpu}"
GPU_QOS="${GPU_QOS:-}"
MOUNT_POINT="${MOUNT_POINT:-$HOME/Cluster}"
NOTEBOOK_DIR="${NOTEBOOK_DIR:-}"

# Locate jupyter-forward engine
find_jupyter_forward() {
    if [[ -x "$HOME/.venvs/jupyter-forward/bin/jupyter-forward" ]]; then
        echo "$HOME/.venvs/jupyter-forward/bin/jupyter-forward"
    elif command -v jupyter-forward >/dev/null 2>&1; then
        command -v jupyter-forward
    else
        echo ""
    fi
}

# Find a free local port
find_free_port() {
    local p="$1"
    while nc -z 127.0.0.1 "$p" 2>/dev/null || (ss -tln 2>/dev/null | grep -q ":$p "); do
        p=$((p + 1))
    done
    echo "$p"
}

# Check that host is defined
require_host() {
    if [[ -z "$HOST" ]]; then
        echo "Error: No cluster host configured." >&2
        echo "Specify with -H <host>, export CLUSTER_HOST=<host>, or run 'cluster config' to set default HOST." >&2
        exit 1
    fi
}

show_capabilities() {
    cat << EOF
================================================================================
cluster - High-Performance Computing Developer Suite (v${VERSION})
Bridging remote clusters seamlessly with your local workstation
================================================================================

Available Commands:

  cluster dev [OPTIONS]
    All-in-one local-remote workspace.
    1. Mounts cluster storage to ~/Cluster (copy-paste / drag-and-drop in Dolphin).
    2. Allocates a dedicated compute/GPU node and drops you into an exclusive shell.
    3. AUTO-CLEANUP: When you exit or close the terminal, it automatically unmounts
       the filesystem and releases the compute node allocation.
    Options:
      -g, --gpu          Allocate a GPU node instead of CPU
      -b, --browse       Auto-open local file manager (Dolphin/Nautilus) upon mount
      -c, --cpus NUM     CPU core count (default: ${SLURM_CPUS})
      -m, --mem MEM      Memory allocation (default: ${SLURM_MEM})
      -t, --time TIME    Walltime limit (default: ${SLURM_TIME})
      -p, --partition P  Slurm partition (default: ${SLURM_PARTITION})
      -q, --qos QOS      Slurm QOS (default: ${SLURM_QOS:-none})
      -A, --account ACC  Slurm account (default: ${SLURM_ACCOUNT:-none})

  cluster shell [OPTIONS]
    Allocate an interactive compute/GPU node and drop directly into an exclusive shell.
    All commands occupy dedicated node CPUs/GPUs until session is closed.
    Automatically cancels and frees the node when terminal closes.
    Options:
      -g, --gpu          Allocate a GPU node
      -c, --cpus NUM     CPU core count (default: ${SLURM_CPUS})
      -m, --mem MEM      Memory allocation (default: ${SLURM_MEM})
      -t, --time TIME    Walltime limit (default: ${SLURM_TIME})
      -p, --partition P  Slurm partition (default: ${SLURM_PARTITION})
      -q, --qos QOS      Slurm QOS (default: ${SLURM_QOS:-none})
      -A, --account ACC  Slurm account (default: ${SLURM_ACCOUNT:-none})

