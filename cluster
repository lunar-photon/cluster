  Current Host: ${HOST:-"(not configured yet - set with 'cluster config')"}

Examples:
  cluster dev -b               # Full workspace: mounts drive + opens Dolphin + compute shell
  cluster shell --gpu          # Dedicated GPU terminal session (auto-freed on close)
