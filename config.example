# cluster-jupyter configuration file
# Place this at ~/.config/cluster-jupyter/config to set your default cluster preferences.

# Cluster SSH host (hostname or ~/.ssh/config Host alias)
HOST="your-cluster.example.edu"

# Default local port (will auto-increment if in use)
PORT=8888

# Default Slurm parameters (used with --slurm)
SLURM_PARTITION="medium"
SLURM_ACCOUNT=""
SLURM_QOS=""
SLURM_CPUS=4
SLURM_MEM="8G"

# Default GPU parameters (used with --gpu)
GPU_PARTITION="gpu"
GPU_QOS=""

# Default remote notebook starting directory
NOTEBOOK_DIR=""
